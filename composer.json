{
  "name": "imbrett/laravel-toolkit",
  "description": "A toolbox to assist with Laravel DX.",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {},
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "phpunit/phpunit": "^12.0",
    "orchestra/testbench": "^11.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "ImBrett\\LaravelTemporal\\": "packages/Temporal/src/",
      "ImBrett\\LaravelCachedPaginator\\": "packages/CachedPaginator/src/",
      "ImBrett\\LaravelApiQuery\\": "packages/ApiQuery/src/",
      "ImBrett\\LaravelListenerAttributes\\": "packages/ListenerAttributes/src/",
      "ImBrett\\LaravelSluggable\\": "packages/Sluggable/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ImBrett\\LaravelTemporal\\Tests\\": "packages/Temporal/tests/",
      "ImBrett\\LaravelCachedPaginator\\Tests\\": "packages/CachedPaginator/tests/",
      "ImBrett\\LaravelApiQuery\\Tests\\": "packages/ApiQuery/tests/",
      "ImBrett\\LaravelListenerAttributes\\Tests\\": "packages/ListenerAttributes/tests/",
      "ImBrett\\LaravelSluggable\\Tests\\": "packages/Sluggable/tests/"
    }
  },
  "repositories": [
    { "type": "path", "url": "packages/*/*", "options": { "symlink": true } }
  ],
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true,
      "target-directory": "_impl"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "find ./packages -type f -name composer.json -not -path '*/vendor/*' -execdir composer update --no-dev \\;"
    ],
    "post-autoload-dump": [
      "find ./packages -type f -name composer.json -not -path '*/vendor/*' -execdir composer dump-autoload --no-dev \\;"
    ],
    "test": "./vendor/bin/phpunit -c phpunit.xml.dist",
    "test-coverage": "XDEBUG_MODE=coverage ./vendor/phpunit/phpunit/phpunit -c phpunit.xml.dist --coverage-text --coverage-clover build/logs/clover.xml",
    "stan": "./vendor/bin/phpstan analyse",
    "rector": "./vendor/bin/rector",
    "ecs": "./vendor/bin/ecs --clear-cache --fix check packages --ansi",
    "insights": "./vendor/bin/phpinsights analyse --no-interaction --min-quality=100 --min-complexity=73 --min-architecture=100 --min-style=100",
    "phpmd": "./vendor/bin/phpmd packages text phpmd_ruleset.xml",
    "metrics": "./vendor/bin/phpmetrics --report-html=build/metrics packages",
    "ci": [
      "@ecs",
      "@stan",
      "@test",
      "@insights"
    ]
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    },
    "sort-packages": true
  }
}
