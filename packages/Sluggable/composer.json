{
  "name": "imbrett/laravel-sluggable",
  "version": "1.1.0",
  "description": "Automatic slug generation and synchronization for Eloquent models.",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "ImBrett\\LaravelSluggable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ImBrett\\LaravelSluggable\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ImBrett\\LaravelSluggable\\Providers\\SluggableServiceProvider"
      ]
    }
  }
}
