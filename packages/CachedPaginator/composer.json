{
  "name": "imbrett/laravel-cached-paginator",
  "version": "1.1.0",
  "description": "Drop-in cached pagination builder for Laravel Eloquent models.",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/pagination": "^11.0|^12.0|^13.0",
    "illuminate/cache": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "ImBrett\\LaravelCachedPaginator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ImBrett\\LaravelCachedPaginator\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ImBrett\\LaravelCachedPaginator\\Providers\\CachedPaginatorServiceProvider"
      ]
    }
  }
}
