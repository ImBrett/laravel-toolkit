{
  "name": "imbrett/laravel-listener-attributes",
  "version": "1.1.0",
  "description": "Attribute-driven event listener registration for Laravel.",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/container": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "ImBrett\\LaravelListenerAttributes\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ImBrett\\LaravelListenerAttributes\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ImBrett\\LaravelListenerAttributes\\Providers\\ListenerAttributesServiceProvider"
      ]
    }
  }
}
